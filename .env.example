# Copy to .env (repo root) and fill in. Never commit .env.
# The backend reads only real environment variables; load this file with:
#   cd backend && uv run --env-file ../.env <command>

# fake (default): offline rule-based agent, no key needed.
# anthropic: the real Claude API; requires ANTHROPIC_API_KEY or startup fails.
LLM_MODE=fake
ANTHROPIC_API_KEY=

# Only when running an installed package (not the repo checkout): where config/ lives.
# SAZON_CONFIG_DIR=/path/to/config

# API (spec 004). All optional.
# DATABASE_URL=sqlite+aiosqlite:///./sazon.db
# APP_ENV=dev            # prod turns off /api/dev/* (seed, silence)
# CORS_ORIGINS=http://localhost:5173
# REENGAGEMENT_SCHEDULER=on   # off: no follow-up loop (spec 008)
# REENGAGEMENT_TIME_SCALE=1   # demo: 60 = an hour of the follow-up schedule per minute

# Voice agent (spec 013), optional. Sofi's voice on /voz via ElevenLabs text-to-speech.
# Empty: the page uses the browser's own (more robotic) voice. The key stays on the server.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # overrides the voice ids in config/voice.yaml (e.g. "Talia")
