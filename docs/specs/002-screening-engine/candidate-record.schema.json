{
  "$defs": {
    "AgeAnswer": {
      "additionalProperties": false,
      "description": "An explicit age, a birth year, or just \"I am over 18\".\n\nPrecedence: age > birth_year > is_adult.\nA birth year is kept as said: the engine works out the age from `today` (spec 003 §8),\nbecause subtracting years is calendar maths the extractor must not do.",
      "properties": {
        "is_adult": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Adult"
        },
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "birth_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Birth Year"
        }
      },
      "title": "AgeAnswer",
      "type": "object"
    },
    "Availability": {
      "enum": [
        "full_time",
        "part_time",
        "weekends"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Bucket": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Country": {
      "enum": [
        "ES",
        "MX"
      ],
      "title": "Country",
      "type": "string"
    },
    "DisqualificationReason": {
      "enum": [
        "under_age",
        "no_license",
        "out_of_area"
      ],
      "title": "DisqualificationReason",
      "type": "string"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "years": {
          "title": "Years",
          "type": "integer"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        }
      },
      "required": [
        "years",
        "platforms"
      ],
      "title": "Experience",
      "type": "object"
    },
    "FactorReason": {
      "description": "Why a score factor earned its points (FR-30); `unknown` = field unclear or missing.",
      "enum": [
        "years_of_experience",
        "known_platforms",
        "availability_breadth",
        "schedule_flexibility",
        "start_date_proximity",
        "unknown"
      ],
      "title": "FactorReason",
      "type": "string"
    },
    "FieldName": {
      "description": "Things the engine can ask for. `zone` and `slot` are ask targets only, not stored fields.",
      "enum": [
        "consent",
        "full_name",
        "age",
        "vehicle_type",
        "has_license",
        "location",
        "zone",
        "availability",
        "schedule",
        "experience",
        "start_date",
        "slot"
      ],
      "title": "FieldName",
      "type": "string"
    },
    "FieldRecord_AgeAnswer_": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgeAnswer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "value"
      ],
      "title": "FieldRecord[AgeAnswer]",
      "type": "object"
    },
    "FieldRecord_Experience_": {
